{
  "info": {
    "name": "Laravel Breeze Starter - API Collection",
    "_postman_id": "breeze-sanctum-api-tkj",
    "description": "API starter collection for Mobile, Desktop, and IoT clients powered by Laravel Sanctum.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Ping (Network & Health Check)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ping",
          "host": ["{{base_url}}"],
          "path": ["ping"]
        },
        "description": "Cek konektivitas server dari jaringan LAN / Client."
      },
      "response": []
    },
    {
      "name": "2. Register New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('token', jsonData.data.token);",
              "    console.log('Token automatically saved to collection variable!');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Siswa TKJ\",\n  \"email\": \"siswa@tkj.sch.id\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"device_name\": \"Postman-Lab-Client\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register",
          "host": ["{{base_url}}"],
          "path": ["register"]
        },
        "description": "Registrasi user baru dari aplikasi client mobile/desktop."
      },
      "response": []
    },
    {
      "name": "3. Login & Get Bearer Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('token', jsonData.data.token);",
              "    console.log('Token successfully captured and stored in collection variable!');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"siswa@tkj.sch.id\",\n  \"password\": \"password123\",\n  \"device_name\": \"Postman-Lab-Client\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Login untuk mendapatkan API Bearer Token (Sanctum)."
      },
      "response": []
    },
    {
      "name": "4. Get Authenticated User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/user",
          "host": ["{{base_url}}"],
          "path": ["user"]
        },
        "description": "Mengakses data user yang terlindungi autentikasi token."
      },
      "response": []
    },
    {
      "name": "5. Logout & Revoke Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": ["{{base_url}}"],
          "path": ["logout"]
        },
        "description": "Menghapus / mencabut (revoke) token akses."
      },
      "response": []
    }
  ]
}

